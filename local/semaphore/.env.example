# For a new installation, replace both values before starting Semaphore.
# For the existing local service, use the private runtime credentials file
# described in README.md. Do not copy its values into this repository.
SEMAPHORE_ADMIN_PASSWORD=replace-with-a-long-unique-password
SEMAPHORE_ACCESS_KEY_ENCRYPTION=replace-with-output-from-openssl-rand-base64-32
